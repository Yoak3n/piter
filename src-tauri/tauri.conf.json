{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "piter",
  "version": "0.1.1",
  "identifier": "com.yoa.piter",
  "build": {
    "beforeDevCommand": "pnpm dev:all",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./nsis-hooks.nsh"
      }
    },
    "resources": {
      "../chat/dist": "chat"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEMEFBMDZEODQzNTU1MUUKUldRZVZUV0ViYUFLYlhTT3BSYm4xODAzQUgwdmJNa2tSNmR5eS91WEcwdjIvNGlLNmNySnh0ckEK",
      "endpoints": [
        "https://github.com/Yoak3n/piter/releases/latest/download/latest.json"
      ]
    }
  }
}
